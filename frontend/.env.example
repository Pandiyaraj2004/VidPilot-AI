# Copy to frontend/.env.local for local development.
# Everything here is bundled into the browser — never put secrets in a VITE_ variable.
VITE_API_BASE_URL=http://localhost:4000/api
# Production (Vercel): set to your Render backend URL, e.g.
# VITE_API_BASE_URL=https://vidpilot-backend.onrender.com/api
