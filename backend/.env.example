# Copy to backend/.env for local development. Never commit the real .env.
PORT=4000
NODE_ENV=development

# Supabase (primary production database + storage) — see README "Database setup".
# When both are set, jobs/config/history/locks and media buckets use Supabase.
# Set FORCE_LOCAL_STORAGE=true to force local JSON/files even when Supabase is configured.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Firebase fallback (optional — used only when Supabase is not configured)
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
AI_REQUEST_TIMEOUT_MS=45000

# Piper (voice) — no API key needed. Only set these if your Piper install
# lives somewhere other than backend/vendor/ — see README "Piper setup".
# PIPER_EXECUTABLE_PATH=
# PIPER_ESPEAK_DATA_PATH=
# PIPER_VOICES_DIR=
# VOICE_STORAGE_DIR=
# PIPER_TIMEOUT_MS=30000

# Edge TTS (Tamil voice) — free Microsoft Edge Read Aloud service, no API
# key. Only network access required; see README "Tamil voice provider".
# EDGE_TTS_TIMEOUT_MS=30000

# FFmpeg / Remotion (video rendering) — only set these if ffmpeg/Chrome
# live somewhere other than backend/vendor/ or the default Windows install
# path. See README "Rendering setup".
# FFMPEG_PATH=
# FFPROBE_PATH=
# FFMPEG_TIMEOUT_MS=120000
# FONTS_DIR=
# VIDEO_STORAGE_DIR=
# VIDEO_WIDTH=1920
# VIDEO_HEIGHT=1080
# VIDEO_FPS=30
# CHROMIUM_EXECUTABLE_PATH=
# RENDER_TIMEOUT_MS=300000

# Visual providers (Phase 5) — Pixabay is primary (videos, images, and
# music all share one key). Pexels is the secondary video/image source.
# Wikimedia Commons needs no key. Get free keys at pixabay.com/api/docs
# and pexels.com/api.
PIXABAY_API_KEY=
PEXELS_API_KEY=

# Jamendo (Phase 6 music) — free client_id at devportal.jamendo.com. Only
# client_id is required for search/download; client_secret is stored for
# completeness but unused by the current read-only integration.
JAMENDO_CLIENT_ID=
JAMENDO_CLIENT_SECRET=
# Optional overrides — defaults (15000 / 45000ms) already account for
# Jamendo's storage CDN being slow (measured well under 200 KB/s in some
# environments); raise JAMENDO_DOWNLOAD_TIMEOUT_MS further if downloads still
# time out for you.
JAMENDO_TIMEOUT_MS=
JAMENDO_DOWNLOAD_TIMEOUT_MS=

# Telegram approval gateway (Phase 10) — free bot via @BotFather. Only the
# bot token + your own chat id are required; the long-poll transport
# (services/telegram/telegramPoller.ts) works with just these two and
# needs no public URL. TELEGRAM_WEBHOOK_SECRET is only needed if you also
# register a real webhook (POST /api/telegram/webhook) for a production
# deployment with a public HTTPS URL — set it to any random string and
# pass the same value as `secret_token` when calling Telegram's
# setWebhook; the route rejects any request whose
# X-Telegram-Bot-Api-Secret-Token header doesn't match.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=


# YouTube upload + thumbnail (Phase 11) — real OAuth via Google Cloud
# Console: create an OAuth 2.0 Client ID (type "Web application"), add
# YOUTUBE_REDIRECT_URI to its Authorized redirect URIs *exactly*, and
# enable the YouTube Data API v3 on that project. YOUTUBE_REDIRECT_URI
# defaults to http://localhost:<PORT>/api/youtube/callback if unset — only
# override it for a real production deployment with a public HTTPS URL.
# The actual OAuth token is obtained by visiting GET /api/youtube/auth in
# a browser once connected, and is stored in backend/data/youtubeToken.json
# (gitignored) — never in an env var.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=
# Where GET /api/youtube/auth sends the browser back to once Google's consent
# screen completes. Defaults to the Vite dev server if unset.
FRONTEND_URL=

# Production deployment (Render): set YOUTUBE_REDIRECT_URI to your public backend URL, e.g.
# https://vidpilot-backend.onrender.com/api/youtube/callback
# Set FRONTEND_URL to your Vercel URL, e.g. https://vidpilot.vercel.app
# On Render free tier (512 MB), Remotion rendering may fail — use Starter (2 GB+) or a dedicated worker.
