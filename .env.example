# Frontend (Vite) — anything prefixed VITE_ is bundled into the browser bundle.
# Never put private keys, tokens, or secrets behind a VITE_ prefix.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_API_BASE_URL=http://localhost:4000/api

# Backend (Node) — server-side only, never exposed to the browser.
PORT=4000
NODE_ENV=development

FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
AI_REQUEST_TIMEOUT_MS=45000

# Piper (voice) — no API key needed; see README "Piper setup". Only set
# these if your Piper install lives somewhere other than backend/vendor/.
# PIPER_EXECUTABLE_PATH=
# PIPER_ESPEAK_DATA_PATH=
# PIPER_VOICES_DIR=
# VOICE_STORAGE_DIR=
# PIPER_TIMEOUT_MS=30000

# Edge TTS (Tamil voice) — free Microsoft Edge Read Aloud service, no API
# key. Only network access required; see README "Tamil voice provider".
# EDGE_TTS_TIMEOUT_MS=30000

# FFmpeg / Remotion (video rendering) — only set these if ffmpeg/Chrome
# live somewhere other than backend/vendor/ or the default Windows install
# path. See README "Rendering setup".
# FFMPEG_PATH=
# FFPROBE_PATH=
# FFMPEG_TIMEOUT_MS=120000
# FONTS_DIR=
# VIDEO_STORAGE_DIR=
# VIDEO_WIDTH=1920
# VIDEO_HEIGHT=1080
# VIDEO_FPS=30
# CHROMIUM_EXECUTABLE_PATH=
# RENDER_TIMEOUT_MS=300000

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=
