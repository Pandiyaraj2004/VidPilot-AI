# Frontend (Vite) — anything prefixed VITE_ is bundled into the browser bundle.
# Never put private keys, tokens, or secrets behind a VITE_ prefix.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_API_BASE_URL=http://localhost:4000/api

# Backend (Node) — server-side only, never exposed to the browser.
PORT=4000
NODE_ENV=development

FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT=

GEMINI_API_KEY=
OPENROUTER_API_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
